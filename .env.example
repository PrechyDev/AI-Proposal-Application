# Copy this file to .env and fill in real values. Never commit .env itself.

# Anthropic API key used for proposal generation/regeneration (spec section 8).
CLAUDE_API_KEY=sk-ant-api03-REPLACE_ME

# Postgres connection string for the shared Supabase instance, pooled
# connection (port 6543). This app's tables live in the "proposal_app"
# schema, isolated from other projects sharing the same instance.
SUPABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres

# Random secret used to sign session cookies. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=REPLACE_ME

# Needed for build step 8 (reference library) - Supabase Storage, for
# uploaded reference files and generated PDFs. Distinct from SUPABASE_URL
# above (that's the Postgres connection string, not the project's REST
# API URL). Find both in the Supabase dashboard under Project Settings ->
# API. Use the service_role key, not the anon key - uploads/downloads for
# this app happen server-side, not from the browser.
SUPABASE_PROJECT_URL=https://REPLACE_ME.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME

# Email provider - Mailjet (switched from Brevo after the Brevo account was
# suspended; before that, switched from Resend because Resend hard-blocks
# sending to anyone but the account owner until a domain is verified).
# Mailjet uses the same model that made Brevo work: a single verified
# sender address is enough to send to any real recipient, no DNS/domain
# work required. Get an API key + secret key at https://app.mailjet.com
# (Account Settings -> API Key Management) after verifying a sender address
# there (Account Settings -> Sender addresses & domains).
#
# Set to false to skip Mailjet entirely (not even checking whether the keys
# below are present) and always use the Gmail fallback instead - e.g. to
# force Gmail during a known Mailjet outage without removing real credentials.
USE_MAILJET=true
MAILJET_API_KEY=your_actual_api_key_here
MAILJET_API_SECRET=your_actual_secret_key_here
EMAIL_FROM_ADDRESS=proposals@your-domain.example
EMAIL_FROM_NAME=Koya Talent

# Backup email path via Gmail SMTP - used automatically if Mailjet isn't
# configured at all, or if a real send to Mailjet's API fails for any
# reason (e.g. the account gets suspended). Not a primary/secondary choice
# made per-send - send_email() always tries Mailjet first when it's
# configured, and only falls back to this if that attempt fails. Requires a
# Gmail account with 2-Step Verification and an App Password (not your
# normal Gmail password) - generate one at
# https://myaccount.google.com/apppasswords.
# Note: unlike Mailjet, mail sent this way shows the real Gmail address as
# the sender (Gmail's SMTP relay won't send "as" an unrelated address
# without domain delegation this app doesn't have). Also note: this
# fallback cannot work at all on Render's free tier, which blocks outbound
# SMTP - it's only a real backup path locally or on a host that allows it.
GMAIL_ADDRESS=your-gmail-address@gmail.com
GMAIL_APP_PASSWORD=your16charapppassword

# Base URL used to build the "log in and review" link in notification
# emails (spec section 6: the email carries no proposal data or shortcut
# access, just a link back into the app). No production domain is chosen
# yet (spec section 9) - defaults to the local dev server.
APP_BASE_URL=http://127.0.0.1:8000
