# Copy this file to .env and fill in real values. Never commit .env itself.

# Anthropic API key used for proposal generation/regeneration (spec section 8).
CLAUDE_API_KEY=sk-ant-api03-REPLACE_ME

# Postgres connection string for the shared Supabase instance, pooled
# connection (port 6543). This app's tables live in the "proposal_app"
# schema, isolated from other projects sharing the same instance.
SUPABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres

# Random secret used to sign session cookies. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=REPLACE_ME

# Needed for build step 8 (reference library) - Supabase Storage, for
# uploaded reference files and generated PDFs. Distinct from SUPABASE_URL
# above (that's the Postgres connection string, not the project's REST
# API URL). Find both in the Supabase dashboard under Project Settings ->
# API. Use the service_role key, not the anon key - uploads/downloads for
# this app happen server-side, not from the browser.
SUPABASE_PROJECT_URL=https://REPLACE_ME.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME

# Email provider - Brevo (switched from Resend: Resend hard-blocks sending
# to anyone but the account owner until a domain is verified; Brevo lets
# you send to any recipient once a single sender address is verified via a
# 6-digit code - no DNS/domain work required to get real sends working).
# Get an API key at https://app.brevo.com (Settings -> SMTP & API -> API Keys)
# after verifying a sender address there.
BREVO_API_KEY=xkeysib-your_actual_key_here
# The central address every proposal-related email is sent from (approver
# notifications, changes-requested notifications, and client delivery -
# not a per-salesperson address). Must be a sender verified in Brevo.
EMAIL_FROM_ADDRESS=proposals@your-domain.example
EMAIL_FROM_NAME=Koya Talent

# Backup email path via Gmail SMTP - used automatically if Brevo isn't
# configured at all, or if a real send to Brevo's API fails for any reason
# (e.g. the account gets suspended). Not a primary/secondary choice made
# per-send - send_email() always tries Brevo first when it's configured,
# and only falls back to this if that attempt fails. Requires a Gmail
# account with 2-Step Verification and an App Password (not your normal
# Gmail password) - generate one at https://myaccount.google.com/apppasswords.
# Note: unlike Brevo, mail sent this way shows the real Gmail address as
# the sender (Gmail's SMTP relay won't send "as" an unrelated address
# without domain delegation this app doesn't have).
GMAIL_ADDRESS=your-gmail-address@gmail.com
GMAIL_APP_PASSWORD=your16charapppassword

# Base URL used to build the "log in and review" link in notification
# emails (spec section 6: the email carries no proposal data or shortcut
# access, just a link back into the app). No production domain is chosen
# yet (spec section 9) - defaults to the local dev server.
APP_BASE_URL=http://127.0.0.1:8000
