# Copy this file to .env and fill in real values. Never commit .env itself.

# Anthropic API key used for proposal generation/regeneration (spec section 8).
CLAUDE_API_KEY=sk-ant-api03-REPLACE_ME

# Postgres connection string for the shared Supabase instance, pooled
# connection (port 6543). This app's tables live in the "proposal_app"
# schema, isolated from other projects sharing the same instance.
SUPABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres

# Random secret used to sign session cookies. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=REPLACE_ME

# Needed for build step 8 (reference library) - Supabase Storage, for
# uploaded reference files and generated PDFs. Distinct from SUPABASE_URL
# above (that's the Postgres connection string, not the project's REST
# API URL). Find both in the Supabase dashboard under Project Settings ->
# API. Use the service_role key, not the anon key - uploads/downloads for
# this app happen server-side, not from the browser.
SUPABASE_PROJECT_URL=https://REPLACE_ME.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME

# Needed for build step 9 (approval flow) - Resend, for the approver
# notification email. Get an API key at https://resend.com/api-keys.
# Until a custom sending domain is verified, Resend only lets you send
# from its sandbox address (onboarding@resend.dev) to the email address
# your Resend account itself is signed up with - fine for dev/testing.
RESEND_API_KEY=re_your_actual_key_here
EMAIL_FROM=onboarding@resend.dev
# Optional - if set, replies to a notification email go here instead of
# the sandbox/no-reply from-address above.
EMAIL_REPLY_TO=your-personal-email@example.com

# Base URL used to build the "log in and review" link in notification
# emails (spec section 6: the email carries no proposal data or shortcut
# access, just a link back into the app). No production domain is chosen
# yet (spec section 9) - defaults to the local dev server.
APP_BASE_URL=http://127.0.0.1:8000
